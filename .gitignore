# ---- RStudio project state ----
.Rproj.user/
spatialGE.Rproj

# ---- Compiled objects (regenerated by R CMD build / install) ----
src/*.o
src/*.so
src/*.dll

# ---- Test / R CMD check artifacts ----
*.Rcheck/
*.tar.gz
tests/testthat/_problems/

# ---- Track CLAUDE.md (project instructions) but not local settings or scratch ----
# Must be `.claude/*`, not `.claude/` -- git does not descend into an excluded
# directory, so a negation inside one would never be seen.
.claude/*
!.claude/CLAUDE.md

# ---- Local R state ----
.Rprofile
.Rhistory
.RData
.Rproj.user/

# ---- Renv ----
renv/
renv.lock

# ---- Dev-only data (large, regenerable) ----
dev/data/
tests/golden/
dev/profiling/out/

# ---- Editor / OS ----
.DS_Store
Rplots.pdf
